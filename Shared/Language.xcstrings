    "language_system": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の設定に従う"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow device settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随设备设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照裝置設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 설정 따르기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar idioma del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre la langue de l’appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätesprache verwenden"
          }
        }
      }
    },
    "language_selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
