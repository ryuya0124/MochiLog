          }
        }
      }
    },
    "cloud_zone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud data zone was not found. Try syncing again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudのデータ領域が見つかりません。しばらくしてから同期を再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 iCloud 数据区域。请稍后重新同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 iCloud 資料區域。請稍後重新同步。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 데이터 영역을 찾을 수 없습니다. 나중에 다시 동기화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la zona de datos de iCloud. Vuelve a sincronizar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone de données iCloud introuvable. Réessayez la synchronisation plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Datenbereich wurde nicht gefunden. Synchronisiere später erneut."
          }
        }
      }
    },
    "cloud_conflict": {
