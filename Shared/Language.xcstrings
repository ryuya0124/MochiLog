        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택됨"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionné"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählt"
          }
        }
      }
    },
    "language_description": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定では端末の言語を使用します。ここで選ぶとアプリの表示言語が切り替わります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default follows your device language. Choose a language here to change the app display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用设备语言。在此选择语言可更改应用的显示语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設使用裝置語言。在此選擇語言可變更App的顯示語言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 기기의 언어를 따릅니다. 여기에서 앱의 표시 언어를 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma predeterminada se usa el idioma del dispositivo. Elige otro para cambiar el idioma de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, la langue de votre appareil est utilisée. Choisissez une langue pour modifier l’affichage de l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird die Gerätesprache verwendet. Wähle hier eine andere Anzeigesprache für die App."
          }
        }
      }
    },
    "watch_connection_failed": {
