          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可檢查的本機紀錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 로컬 기록이 없습니다."
          }
        },
        "es": {
