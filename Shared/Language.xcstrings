    "cloud_diagnostic_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check local records and iCloud account status without creating or deleting cloud records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上の記録を作成・削除せず、ローカル記録とiCloudアカウントの状態を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查本地记录和 iCloud 账户状态，不创建或删除云端记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查本機紀錄和 iCloud 帳號狀態，不建立或刪除雲端紀錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 기록을 생성하거나 삭제하지 않고 로컬 기록과 iCloud 계정 상태를 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los registros locales y el estado de la cuenta iCloud sin crear ni eliminar registros en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les relevés locaux et l’état du compte iCloud sans créer ni supprimer de relevés dans le cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft lokale Datensätze und den iCloud-Kontostatus, ohne Cloud-Datensätze anzulegen oder zu löschen."
          }
        }
      }
    },
    "cloud_diagnostic_pass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked %d local records. This does not verify upload or cross-device synchronization."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル記録%d件を確認しました。アップロードや端末間同期の成功を確認するものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检查 %d 条本地记录。这不代表已验证上传或跨设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢查 %d 筆本機紀錄。這不代表已驗證上傳或跨裝置同步。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 기록 %d개를 확인했습니다. 업로드 또는 기기 간 동기화 성공을 검증한 것은 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprobaron %d registros locales. Esto no verifica la carga ni la sincronización entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d relevés locaux vérifiés. Cela ne valide ni l’envoi ni la synchronisation entre appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d lokale Datensätze geprüft. Damit sind Upload und geräteübergreifende Synchronisierung noch nicht bestätigt."
          }
        }
      }
    },
    "cloud_diagnostic_no_store": {
      "extractionState": "manual",
      "localizations": {
