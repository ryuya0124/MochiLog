    "pip_instruction" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Picture-in-Picture to keep watching"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピクチャ・イン・ピクチャで視聴を続けられます"
          }
        }
      }
    },
    "pip_instruction_detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The video will continue playing in a floating window.\n*Please ensure Picture in Picture is enabled in Settings > General > Picture in Picture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画はフローティングウィンドウで再生され続けます。\n※iPhone/iPadの設定 > 一般 > ピクチャ・イン・ピクチャ をオンにしてください。"
          }
        }
      }
    },
    "pip_note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: Due to iOS limitations, PIP may occasionally fail to display. Restarting the app or device may resolve this issue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※iOSの不具合により、PIPが稀に表示されない場合があります。\nアプリや端末の再起動で直る場合があります。"
          }
        }
      }
    },
