    "iPhone Airのログにおいて、MagSafeバッテリー特有の条件に合致した場合、自動的に「iPhone Air MagSafeバッテリー」として登録するか、毎回手動で選ぶかを設定します。": {
      "comment": "A description of the iPhone Air / MagSafe battery setting.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether iPhone Air logs matching the MagSafe battery criteria are registered automatically as an iPhone Air MagSafe Battery or require manual selection each time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Airのログにおいて、MagSafeバッテリー特有の条件に合致した場合、自動的に「iPhone Air MagSafeバッテリー」として登録するか、毎回手動で選ぶかを設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择符合MagSafe电池条件的iPhone Air日志是自动登记为MagSafe电池，还是每次手动选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇符合MagSafe電池條件的iPhone Air日誌要自動登錄為MagSafe電池，還是每次手動選擇。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MagSafe 배터리 조건에 맞는 iPhone Air 로그를 자동 등록할지 매번 직접 선택할지 정합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si los registros del iPhone Air que coinciden con una batería MagSafe se registran automáticamente o se seleccionan manualmente cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si les journaux de l’iPhone Air correspondant à une batterie MagSafe sont enregistrés automatiquement ou sélectionnés manuellement à chaque fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, ob passende iPhone-Air-Protokolle automatisch als MagSafe-Batterie erkannt werden oder jedes Mal manuell ausgewählt werden müssen."
          }
        }
      }
    },
    "lastSeenVersionを任意の値に変更できます。Discord告知の再表示テストなどに使用してください。": {
      "comment": "A footer description for the \"lastSeenVersion\" section in the DeveloperOptionsView.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change lastSeenVersion to test the Discord announcement and other update behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lastSeenVersionを任意の値に変更できます。Discord告知の再表示テストなどに使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可修改lastSeenVersion以测试Discord公告等更新行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可修改lastSeenVersion以測試Discord公告等更新行為。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lastSeenVersion을 변경하여 Discord 공지 등의 업데이트 동작을 테스트할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia lastSeenVersion para probar el anuncio de Discord y otras funciones de actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez lastSeenVersion pour tester l’annonce Discord et le comportement des mises à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere lastSeenVersion, um die Discord-Mitteilung und das Updateverhalten zu testen."
          }
        }
      }
    },
    "lastSeenVersionを削除して、次回起動時にDiscord告知が表示されるようにします。": {
      "comment": "An alert message explaining that resetting `lastSeenVersion` will cause the app to show the Discord announcement again on the next launch.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete lastSeenVersion to reset the Discord announcement state for the next launch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lastSeenVersionを削除して、次回起動時にDiscord告知が表示されるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除lastSeenVersion以重置下次启动时的Discord公告状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除lastSeenVersion以重設下次啟動時的Discord公告狀態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lastSeenVersion을 삭제하여 다음 실행 시 Discord 공지 상태를 초기화합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina lastSeenVersion para restablecer el anuncio de Discord en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez lastSeenVersion pour réinitialiser l’annonce Discord au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche lastSeenVersion, um den Status der Discord-Mitteilung für den nächsten Start zurückzusetzen."
          }
