    "select_a_device_description": {
      "comment": "Short description for device selection UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a device to filter the charts and statistics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフと統計を絞り込むデバイスを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择设备以筛选图表和统计数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇裝置以篩選圖表與統計資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트와 통계를 필터링할 기기를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un dispositivo para filtrar los gráficos y las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un appareil pour filtrer les graphiques et les statistiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Gerät zum Filtern der Diagramme und Statistiken."
          }
        }
      }
    },
