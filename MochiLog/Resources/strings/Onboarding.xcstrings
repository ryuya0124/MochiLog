    "pip_step_tap_back_button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap back button (top left)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の「戻る」をタップ"
          }
        }
      }
