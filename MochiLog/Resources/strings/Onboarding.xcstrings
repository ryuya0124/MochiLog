{
  "sourceLanguage": "ja",
  "strings": {
    "open_analytics_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリを開く"
          }
        }
      }
    },
    "pip_instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Picture-in-Picture to keep watching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクチャ・イン・ピクチャで視聴を続けられます"
          }
        }
      }
    },
    "pip_instruction_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video will continue playing in a floating window.\n*Please ensure Picture in Picture is enabled in Settings > General > Picture in Picture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はフローティングウィンドウで再生され続けます。\n※iPhone/iPadの設定 > 一般 > ピクチャ・イン・ピクチャ をオンにしてください。"
          }
        }
      }
    },
    "pip_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Due to iOS limitations, PIP may occasionally fail to display. Restarting the app or device may resolve this issue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※iOSの不具合により、PIPが稀に表示されない場合があります。\nアプリや端末の再起動で直る場合があります。"
          }
        }
      }
    },
    "pip_step_analytics_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics Data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析データ"
          }
        }
      }
    },
    "pip_step_analytics_improvements": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics & Improvements"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析と改善"
          }
        }
      }
    },
    "pip_step_button_at_bottom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button is at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンは下の方にあります"
          }
