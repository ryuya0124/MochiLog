    },
    "tutorial_go_to_settings_top_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're in the wrong section, go back to the Settings top screen.\nTap the back button in the upper left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違った場所にいる場合は、設定のトップ画面に戻ります。\n左上の戻るボタンをタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果当前页面不正确，请点击左上角的返回按钮，回到“设置”首页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若目前頁面不正確，請點選左上角的返回按鈕，回到「設定」首頁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 화면에 있다면 왼쪽 위 뒤로 버튼을 눌러 설정 첫 화면으로 돌아가세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si estás en otra sección, pulsa Atrás arriba a la izquierda para volver al inicio de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous êtes dans une autre rubrique, touchez Retour en haut à gauche pour revenir à l’accueil de Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls du im falschen Bereich bist, tippe oben links auf Zurück, um zur Startseite der Einstellungen zurückzukehren."
          }
        }
      }
    },
