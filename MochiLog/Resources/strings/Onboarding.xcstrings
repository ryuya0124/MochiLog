    "tutorial_analytics_improvements_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select 'Analytics & Improvements' from the menu.\nThe button is located at the bottom of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューから「解析と改善」を選択します。\nボタンは画面の下の方にあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单中选择“分析与改进”。按钮位于页面下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從選單中選擇「分析與改進」。按鈕位於頁面下方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴에서 분석 및 향상을 선택하세요. 버튼은 화면 아래쪽에 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona Análisis y mejoras en el menú. El botón está al final de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Analyse et améliorations dans le menu. Le bouton se trouve en bas de l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Analyse & Verbesserungen im Menü. Die Taste befindet sich unten auf dem Bildschirm."
          }
        }
      }
    },
