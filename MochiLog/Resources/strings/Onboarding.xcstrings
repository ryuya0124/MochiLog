    "pip_step_choose_larger_file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short files lack battery data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いファイルには情報が入っていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较短的日志不含电池信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較短的日誌不含電池資訊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 로그에는 배터리 정보가 없습니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros cortos no incluyen datos de batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
