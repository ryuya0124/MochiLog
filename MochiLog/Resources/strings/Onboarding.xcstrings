    "pip_step_wait_next_day": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until the next day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の日まで待ってください"
          }
        }
      }
    },
    "try_with_video": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Video Guide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画で確認しながら操作する"
          }
        }
      }
    },
    "tutorial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutorial"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チュートリアル"
          }
        }
      }
    },
    "tutorial_analytics_improvements_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select 'Analytics & Improvements' from the menu.\nThe button is located at the bottom of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューから「解析と改善」を選択します。\nボタンは画面の下の方にあります。"
          }
        }
      }
    },
    "tutorial_analytics_improvements_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytics & Improvements"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析と改善"
          }
        }
      }
    },
    "tutorial_complete_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're all set!\nTrack your battery health with MochiLog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了です！\nMochiLogでバッテリーの状態を詳しく分析しましょう。"
          }
        }
      }
    },
    "tutorial_complete_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了！"
          }
        }
      }
    },
    "tutorial_enable_analytics_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings > Privacy & Security > Analytics & Improvements"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > プライバシーとセキュリティ > 解析と改善\nを開きます。"
          }
        }
      }
    },
    "tutorial_enable_analytics_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "tutorial_find_log_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Analytics Data, find the latest file starting with\n'Analytics-yyyy-mm-dd'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析データ内で\n「Analytics-yyyy-mm-dd」\nで始まる最新のファイルを探します。"
          }
        }
      }
    },
    "tutorial_find_log_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the Log File"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログファイルを探す"
          }
        }
      }
    },
    "tutorial_log_selection_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short log files with only a few dozen lines do not contain battery information.\nPlease select a different, larger file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数十行の短いログデータにはバッテリー情報が含まれていません。\n他のより大きなファイルを選んでください。"
          }
        }
      }
    },
    "tutorial_log_selection_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important: Choose the Right File"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要: 正しいファイルを選択"
          }
        }
      }
    },
    "tutorial_log_timing_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After enabling analytics sharing, logs are generated daily at 9:00 AM.\nPlease wait until the next day to find the log file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析を共有をONにしても、ログが生成されるのは毎日9:00です。\n次の日まで待ってからログファイルを探してください。"
          }
        }
      }
    },
    "tutorial_log_timing_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important: Log Generation Timing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要: ログ生成のタイミング"
          }
        }
