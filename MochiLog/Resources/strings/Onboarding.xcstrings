    "pip_step_choose_larger_file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short files lack battery data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いファイルには情報が入っていません"
          }
