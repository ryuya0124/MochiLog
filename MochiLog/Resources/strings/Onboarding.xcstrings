        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After enabling analytics sharing, logs are generated daily at 9:00 AM.\nPlease wait until the next day to find the log file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析を共有をONにしても、ログが生成されるのは毎日9:00です。\n次の日まで待ってからログファイルを探してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启共享分析后，日志每天9:00生成。请等到第二天再查找日志文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟分享分析後，日誌每天9:00產生。請等到隔天再尋找日誌檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 공유를 켜면 로그는 매일 오전 9시에 생성됩니다. 다음 날 로그 파일을 찾아주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activar los análisis, los registros se generan a diario a las 9:00. Espera hasta el día siguiente para buscar el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après activation du partage, les journaux sont générés chaque jour à 9 h. Attendez le lendemain pour rechercher le fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Aktivierung werden die Protokolle täglich um 9 Uhr erstellt. Suche die Protokolldatei erst am nächsten Tag."
          }
        }
      }
    },
