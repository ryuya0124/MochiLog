    "pip_step_if_not_listed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If not listed, check 'More'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストにない場合は「その他」から"
          }
