    "tutorial_share_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Share button and select MochiLog.\nThe log will be automatically imported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ボタンをタップして、MochiLogを選択します。\nログが自動的にインポートされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击共享按钮并选择MochiLog。日志将自动导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選分享按鈕並選擇MochiLog。日誌將自動匯入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 버튼을 누르고 MochiLog를 선택하세요. 로그가 자동으로 가져와집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Compartir y selecciona MochiLog. El registro se importará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Partager et sélectionnez MochiLog. Le journal sera importé automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Teilen und wähle MochiLog. Das Protokoll wird automatisch importiert."
          }
        }
      }
    },
