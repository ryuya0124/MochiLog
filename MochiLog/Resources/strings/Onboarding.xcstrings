    "pip_step_go_to_settings_top": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings Top"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定のトップに移動"
          }
