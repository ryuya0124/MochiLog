{
  "sourceLanguage": "ja",
  "strings": {
    "open_analytics_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリを開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「設定」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 앱 열기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Réglages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        }
      }
    },
    "pip_instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Picture-in-Picture to keep watching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクチャ・イン・ピクチャで視聴を続けられます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用画中画继续观看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用子母畫面繼續觀看"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 속 화면으로 계속 시청"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa viendo con imagen dentro de imagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez avec l’image dans l’image"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Bild-in-Bild weiter ansehen"
          }
        }
      }
    },
    "pip_instruction_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video will continue playing in a floating window.\n*Please ensure Picture in Picture is enabled in Settings > General > Picture in Picture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はフローティングウィンドウで再生され続けます。\n※iPhone/iPadの設定 > 一般 > ピクチャ・イン・ピクチャ をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频将继续在浮动窗口中播放。\n请在“设置”>“通用”>“画中画”中启用此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片會繼續在浮動視窗播放。\n請在「設定」>「一般」>「子母畫面」中啟用此功能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상은 작은 창에서 계속 재생됩니다.\n설정 > 일반 > 화면 속 화면을 켜주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo seguirá en una ventana flotante.\nActiva la función en Ajustes > General > Imagen dentro de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo continuera dans une fenêtre flottante.\nActivez Réglages > Général > Image dans l’image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video läuft in einem schwebenden Fenster weiter.\nAktiviere Einstellungen > Allgemein > Bild-in-Bild."
          }
        }
      }
    },
    "pip_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Due to iOS limitations, PIP may occasionally fail to display. Restarting the app or device may resolve this issue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※iOSの不具合により、PIPが稀に表示されない場合があります。\nアプリや端末の再起動で直る場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于iOS问题，画中画有时可能不显示。重新启动应用或设备可能有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於iOS問題，子母畫面有時可能無法顯示。重新啟動App或裝置可能有幫助。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 문제로 화면 속 화면이 나타나지 않을 수 있습니다. 앱이나 기기를 다시 실행해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por limitaciones de iOS, la ventana flotante puede no aparecer. Reiniciar la app o el dispositivo puede resolverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image dans l’image peut parfois ne pas apparaître à cause d’iOS. Redémarrer l’app ou l’appareil peut aider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgrund von iOS-Problemen erscheint Bild-in-Bild manchmal nicht. Ein Neustart der App oder des Geräts kann helfen."
          }
        }
      }
    },
