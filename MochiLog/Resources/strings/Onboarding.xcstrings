    "tutorial_welcome_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your device battery health in detail.\nLet's set up together!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのバッテリー状態を詳しく記録できます。\n一緒に設定しましょう！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详细记录设备的电池状态。\n让我们一起完成设置！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細記錄裝置的電池狀態。\n一起完成設定吧！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 배터리 상태를 자세히 기록하세요.\n함께 설정해 볼까요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra en detalle el estado de tu batería.\n¡Vamos a configurarlo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez en détail l’état de votre batterie.\nConfigurons l’app ensemble !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse den Batteriezustand deines Geräts im Detail.\nRichten wir die App gemeinsam ein!"
          }
        }
      }
    },
    "tutorial_open_settings_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings App"
          }
        },
        "ja": {
