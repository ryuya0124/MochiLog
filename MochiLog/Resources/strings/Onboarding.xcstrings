    "tutorial_find_log_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Analytics Data, find the latest file starting with\n'Analytics-yyyy-mm-dd'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析データ内で\n「Analytics-yyyy-mm-dd」\nで始まる最新のファイルを探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在分析数据中查找以“Analytics-yyyy-mm-dd”开头的最新文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在分析資料中尋找以「Analytics-yyyy-mm-dd」開頭的最新檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 데이터에서 Analytics-yyyy-mm-dd로 시작하는 최신 파일을 찾으세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Datos de análisis, busca el archivo más reciente que empiece por Analytics-yyyy-mm-dd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Données d’analyse, trouvez le fichier le plus récent commençant par Analytics-yyyy-mm-dd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche in den Analysedaten die neueste Datei, die mit Analytics-yyyy-mm-dd beginnt."
          }
        }
      }
    },
