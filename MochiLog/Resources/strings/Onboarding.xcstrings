    "tutorial_open_settings_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Settings app on your iPhone or iPad.\nTap the button below to open Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneやiPadの設定アプリを開きます。\n下のボタンをタップして設定を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开iPhone或iPad的“设置”应用。点击下方按钮即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟iPhone或iPad的「設定」App。點選下方按鈕即可開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad의 설정 앱을 여세요. 아래 버튼을 누르면 열립니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes en tu iPhone o iPad con el botón de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Réglages de votre iPhone ou iPad avec le bouton ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Einstellungen deines iPhone oder iPad über die Taste unten."
          }
        }
      }
    },
    "tutorial_go_to_settings_top_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Back to Settings Top"
          }
        },
        "ja": {
