    "tutorial_log_selection_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short log files with only a few dozen lines do not contain battery information.\nPlease select a different, larger file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数十行の短いログデータにはバッテリー情報が含まれていません。\n他のより大きなファイルを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有几十行的较短日志不含电池信息。请选择其他更大的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有數十行的較短日誌不含電池資訊。請選擇其他較大的檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수십 줄 정도의 짧은 로그에는 배터리 정보가 없습니다. 다른 큰 파일을 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de unas pocas decenas de líneas no contienen información de batería. Elige otro archivo más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux de quelques dizaines de lignes ne contiennent pas d’informations sur la batterie. Choisissez un fichier plus volumineux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Protokolle mit nur wenigen Dutzend Zeilen enthalten keine Batterieinformationen. Wähle eine andere, größere Datei."
          }
        }
      }
    },
