    "icloud_sync_footer": {
      "comment": "A description of the iCloud sync settings.",
      "extractionState": "extracted_with_value",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期をオンにすると、同じApple IDでサインインした複数のデバイス間でバッテリー記録を自動的に共有できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, battery records are shared automatically between devices using the same Apple ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，电池记录将在使用同一 Apple ID 的设备之间自动共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，電池紀錄會在使用相同 Apple ID 的裝置之間自動共享。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 같은 Apple ID를 사용하는 기기 간에 배터리 기록이 자동으로 공유됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, los registros de batería se comparten automáticamente entre dispositivos con el mismo Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, les relevés de batterie sont partagés automatiquement entre appareils utilisant le même identifiant Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Batteriedaten automatisch zwischen Geräten mit derselben Apple-ID geteilt."
          }
        }
      }
    },
    "icloud_sync_how1": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はアプリ起動時やバックグラウンドで自動的に行われます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization runs when the app opens and in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用启动时及在后台自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 啟動時及在背景自動同步。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 시작할 때와 백그라운드에서 자동으로 동기화됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización se realiza al abrir la app y en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation s’effectue à l’ouverture de l’app et en arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung erfolgt beim App-Start und im Hintergrund."
          }
        }
      }
    },
    "icloud_sync_how2": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「強制同期」はローカルの変更をiCloudにプッシュし、既に受信済みのデータを表示に反映します"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Sync sends local changes and applies data already received."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制同步会发送本地更改，并应用已收到的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制同步會傳送本機變更，並套用已收到的資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 동기화는 로컬 변경 사항을 보내고 이미 수신한 데이터를 반영합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar la sincronización envía los cambios locales y aplica los datos ya recibidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer la synchronisation envoie les modifications locales et applique les données déjà reçues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erzwungene Synchronisierung sendet lokale Änderungen und übernimmt bereits empfangene Daten."
          }
        }
      }
    },
    "icloud_sync_how3": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他デバイスのデータを引き出すタイミングはAppleのサーバーが决定します。数秒〜数分かかる場合があります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple servers determine when data from other devices arrives. This may take a few seconds to several minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他设备的数据何时送达由 Apple 服务器决定，可能需要几秒到几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他裝置的資料何時送達由 Apple 伺服器決定，可能需要幾秒到幾分鐘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 데이터 수신 시점은 Apple 서버가 결정하며, 몇 초에서 몇 분이 걸릴 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores de Apple deciden cuándo llegan los datos de otros dispositivos. Puede tardar de unos segundos a varios minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs Apple déterminent quand les données des autres appareils arrivent. Cela peut prendre de quelques secondes à plusieurs minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Server bestimmen, wann Daten anderer Geräte eintreffen. Das kann einige Sekunden bis mehrere Minuten dauern."
          }
        }
      }
    },
    "icloud_sync_how4": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制同期後も表示されない場合は、アプリを完全に終了（スワイプアップ）して再起動すると反映されます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If data still does not appear after Force Sync, close and reopen the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制同步后仍未显示时，请关闭应用并重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制同步後仍未顯示時，請關閉 App 並重新開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 동기화 후에도 표시되지 않으면 앱을 종료했다가 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los datos no aparecen tras forzar la sincronización, cierra la app y vuelve a abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les données n’apparaissent pas après une synchronisation forcée, fermez puis rouvrez l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Daten nach erzwungener Synchronisierung nicht erscheinen, schließe die App und öffne sie erneut."
          }
        }
      }
    },
