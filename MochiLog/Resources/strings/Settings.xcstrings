    "multiple_watch_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When importing a Watch log with multiple watches registered, you will be prompted to select which watch to use."
          }
        },
        "ja": {
          "stringUnit": {
