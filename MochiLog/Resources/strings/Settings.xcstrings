    "remove_all_watches_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all registered watches? This will stop automatic model detection for future logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済みのすべてのWatchを削除しますか？今後ログで自動的にWatchモデルが適用されなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有已注册 Apple Watch 吗？将不再自动识别型号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有已登錄 Apple Watch 嗎？將不再自動辨識型號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록된 모든 Apple Watch를 삭제할까요? 모델 자동 감지가 중지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los Apple Watch registrados? Se desactivará la detección automática del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer toutes les Apple Watch enregistrées ? La détection automatique du modèle sera désactivée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle registrierten Apple Watches entfernen? Die automatische Modellerkennung wird deaktiviert."
          }
        }
      }
    },
