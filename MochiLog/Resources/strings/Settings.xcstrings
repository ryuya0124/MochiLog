    "register_watch_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registering this Apple Watch will automatically use this model for future logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Watchを登録すると、次回から自動的にこのモデルとして解析されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册此 Apple Watch 型号后，今后导入日志时会自动使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登錄此 Apple Watch 型號後，日後匯入日誌時會自動使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple Watch 모델을 등록하면 이후 로그를 가져올 때 자동으로 사용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra este modelo de Apple Watch para usarlo automáticamente en futuros registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce modèle d’Apple Watch pour l’utiliser automatiquement lors des prochaines importations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registriere dieses Apple-Watch-Modell, um es künftig automatisch für Protokolle zu verwenden."
          }
        }
      }
    },
