        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を反映するにはアプリの再起動が必要です。一度アプリを上にスワイプして完全に終了し、開き直してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the app after changing this setting. Swipe it up in the app switcher to close it completely, then reopen it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改后需要重新启动应用。请从应用切换器中向上轻扫以完全关闭应用，然后重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更後需要重新啟動 App。請從 App 切換器向上滑動以完全關閉 App，再重新開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 후 앱을 다시 시작해야 합니다. 앱 전환기에서 위로 쓸어 올려 앱을 완전히 종료한 다음 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario reiniciar la app. Desliza hacia arriba en el selector de apps para cerrarla por completo y vuelve a abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un redémarrage de l’app est nécessaire. Fermez-la complètement en balayant vers le haut dans le sélecteur d’apps, puis rouvrez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App muss neu gestartet werden. Schließe sie im App-Umschalter durch Wischen nach oben vollständig und öffne sie erneut."
          }
        }
      }
    },
