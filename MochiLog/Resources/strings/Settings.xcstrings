    "validation_threshold_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors when log design capacity is N times or 1/N of device specs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログの設計容量が端末スペックの N倍以上、または 1/N以下の時にエラーにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志中的设计容量大于等于设备规格的 N 倍或小于等于 1/N 时，显示错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌中的設計容量大於等於裝置規格的 N 倍或小於等於 1/N 時，顯示錯誤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그의 설계 용량이 기기 사양의 N배 이상이거나 1/N 이하이면 오류로 처리합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un error si la capacidad de diseño del registro es al menos N veces o como máximo 1/N de la especificada para el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale une erreur si la capacité nominale du journal atteint N fois celle de l’appareil ou ne dépasse pas 1/N de celle-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Fehler, wenn die Auslegungskapazität im Protokoll mindestens das N-Fache oder höchstens 1/N der Gerätespezifikation beträgt."
          }
        }
      }
    },
