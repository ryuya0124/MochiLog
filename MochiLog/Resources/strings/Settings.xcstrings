    "donation_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you enjoy using MochiLog, please consider supporting the developer to help continue development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLogを気に入っていただけましたら、開発の継続のためにご支援をいただけると幸いです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您喜欢MochiLog，欢迎支持开发者，帮助我们继续开发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您喜歡MochiLog，歡迎支持開發者，協助我們持續開發。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MochiLog가 마음에 드신다면 지속적인 개발을 위해 개발자를 후원해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te gusta MochiLog, considera apoyar al desarrollador para que pueda seguir mejorándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous appréciez MochiLog, pensez à soutenir son développeur pour poursuivre son amélioration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir MochiLog gefällt, unterstütze den Entwickler, damit die Weiterentwicklung fortgesetzt werden kann."
          }
        }
      }
    },
