          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备尚未登录 iCloud，或未启用 iCloud 云盘。请检查 iOS 设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
