      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the registered Apple Watch? This will stop automatic model detection for future logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済みのApple Watchを解除しますか？今後ログで自動的にこのモデルが適用されなくなります。"
