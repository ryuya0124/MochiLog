    "conflict_detail_description": {
      "comment": "A description of the conflict detail view.",
      "extractionState": "extracted_with_value",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同一の記録が複数のデバイスで同時に変更されました。以下の差分を確認し、どちらのデータを保持するか選択してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same record was changed on multiple devices at the same time. Review the differences below and choose which data to keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一记录在多台设备上同时修改。请检查以下差异并选择要保留的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一記錄在多台裝置上同時修改。請檢查以下差異並選擇要保留的資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 기록이 여러 기기에서 동시에 변경되었습니다. 차이를 확인하고 보존할 데이터를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo registro se modificó en varios dispositivos. Revisa las diferencias y elige los datos que deseas conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même relevé a été modifié sur plusieurs appareils. Vérifiez les différences et choisissez les données à conserver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Aufzeichnung wurde auf mehreren Geräten geändert. Prüfe die Unterschiede und wähle die zu behaltenden Daten."
          }
        }
      }
    },
