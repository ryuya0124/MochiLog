          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer la synchronisation effectue les opérations suivantes :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erzwingen der Synchronisierung wird Folgendes ausgeführt:"
          }
        }
      }
    },
    "force_sync_note": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※ 他デバイスのデータを引き出すのは Appleのサーバー任せになります。強制同期後にデータが表示されない場合は、数分待ってからアプリを再起動してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple servers determine when data from other devices arrives. If data does not appear after Force Sync, wait a few minutes, then restart the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他设备获取数据的时机由Apple服务器决定。若强制同步后仍未显示数据，请等待几分钟后重启应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從其他裝置取得資料的時機由Apple伺服器決定。若強制同步後仍未顯示資料，請等待幾分鐘後重新啟動App。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기 데이터의 수신 시점은 Apple 서버가 결정합니다. 강제 동기화 후 표시되지 않으면 몇 분 뒤 앱을 다시 실행하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple decide cuándo se reciben los datos de otros dispositivos. Si no aparecen tras forzar la sincronización, espera unos minutos y reinicia la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple décide du moment de réception des données des autres appareils. Si elles n’apparaissent pas, attendez quelques minutes puis redémarrez l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bestimmt, wann Daten anderer Geräte abgerufen werden. Falls sie nach dem Erzwingen nicht erscheinen, warte einige Minuten und starte die App neu."
          }
        }
      }
    },
