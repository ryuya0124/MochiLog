    "icloud_not_signed_in": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末がiCloudにサインインしていないか、iCloud Driveが無効になっています。iOSの設定アプリから確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
