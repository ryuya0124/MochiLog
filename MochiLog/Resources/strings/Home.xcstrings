    "log_saved_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A parse error log has been saved. You can view it in Support -> Error Logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析エラーのログを保存しました。サポートの「エラーログを表示」から確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存解析错误日志。可在“支持”中的“错误日志”查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存解析錯誤日誌。可在「支援」中的「錯誤日誌」查看。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 오류 로그가 저장되었습니다. 지원의 오류 로그에서 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardó el registro del error de análisis. Puedes verlo en Soporte > Registros de errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un journal d’erreur d’analyse a été enregistré. Consultez Assistance > Journaux d’erreurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Analysefehlerprotokoll wurde gespeichert. Du findest es unter Support > Fehlerprotokolle."
          }
        }
      }
    },
    "mismatch_warning_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log design capacity differs significantly from device specs. Would you like to select the correct model manually?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログの設計容量が端末スペックと大きく異なります。正しい機種を手動で選択しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志中的设计容量与设备规格存在较大差异。要手动选择正确的机型吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌中的設計容量與裝置規格差異過大。要手動選擇正確機型嗎？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그의 설계 용량이 기기 사양과 크게 다릅니다. 올바른 모델을 직접 선택할까요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacidad de diseño difiere mucho de las especificaciones. ¿Quieres seleccionar el modelo correcto manualmente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacité de conception diffère fortement des spécifications. Voulez-vous choisir manuellement le bon modèle ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auslegungskapazität weicht deutlich von den Spezifikationen ab. Möchtest du das richtige Modell manuell auswählen?"
          }
        }
      }
    },
