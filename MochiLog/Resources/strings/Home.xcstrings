            "value": "添加数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增資料"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 추가"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des données"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten hinzufügen"
          }
        }
      }
    },
    "capacity_mismatch_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log design capacity differs significantly from device specs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログの設計容量が端末のスペックと大きく異なります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志中的设计容量与设备规格存在较大差异"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌中的設計容量與裝置規格差異過大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그의 설계 용량이 기기 사양과 크게 다릅니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacidad de diseño del registro difiere mucho de las especificaciones del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacité de conception du journal diffère fortement des spécifications de l’appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auslegungskapazität im Protokoll weicht deutlich von den Gerätespezifikationen ab"
          }
        }
      }
    },
    "clear_all_logs": {
      "localizations": {
        "en": {
