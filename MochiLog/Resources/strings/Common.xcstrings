    "device_info_included": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information about your device and OS version will be automatically included in your inquiry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせには、ご利用の端末情報とOSバージョンが自動的に含まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的设备信息和系统版本将自动附在咨询中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的裝置資訊與系統版本將自動附在詢問中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문의에 기기 정보와 OS 버전이 자동으로 포함됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información del dispositivo y la versión del sistema se incluirán automáticamente en tu consulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations sur votre appareil et la version du système seront automatiquement jointes à votre demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräteinformationen und Betriebssystemversion werden deiner Anfrage automatisch beigefügt."
          }
        }
      }
    },
