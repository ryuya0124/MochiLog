    "settings_display_diagnostic_high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings display is %d%%. This often reflects calibration differences; battery appears healthy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定上の表示は %d%% です。校正差の可能性が高く、状態は良好に見えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中显示为%d%%。这可能是校准差异，电池状态看起来良好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定中顯示為%d%%。這可能是校準差異，電池狀態看起來良好。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 표시값은 %d%%입니다. 보정 차이일 가능성이 높으며 상태는 양호해 보입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra %d%%. Probablemente se deba a la calibración; la batería parece estar en buen estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages affichent %d%%. Cela reflète probablement l’étalonnage ; la batterie semble en bon état."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen %d%%. Das liegt wahrscheinlich an der Kalibrierung; die Batterie scheint in gutem Zustand zu sein."
          }
        }
      }
    },
    "settings_display_diagnostic_low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings display is %d%% — battery health is low; consider replacing the battery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定上の表示は %d%% です。バッテリーの状態が低下しています。交換を検討してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中显示为%d%%。电池健康度较低，建议考虑更换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定中顯示為%d%%。電池健康度較低，建議考慮更換。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 표시값은 %d%%입니다. 배터리 상태가 낮으므로 교체를 고려하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra %d%%. El estado es bajo; considera sustituir la batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages affichent %d%%. L’état de la batterie est faible ; envisagez son remplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen %d%%. Der Batteriezustand ist niedrig; erwäge einen Austausch."
          }
        }
      }
    },
    "settings_display_diagnostic_normal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings display is %d%% — battery is showing signs of wear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定上の表示は %d%% です。バッテリーに劣化の傾向が見られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中显示为%d%%。电池出现损耗迹象。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定中顯示為%d%%。電池出現耗損跡象。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 표시값은 %d%%입니다. 배터리에 마모 징후가 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra %d%%. La batería presenta signos de desgaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages affichent %d%%. La batterie montre des signes d’usure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen %d%%. Die Batterie weist Verschleiß auf."
          }
        }
      }
    },
    "settings_display_diagnostic_slight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings display is %d%% — battery is slightly degraded but still usable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定上の表示は %d%% です。やや劣化していますが、まだ使用可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中显示为%d%%。电池有轻度损耗，但仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定中顯示為%d%%。電池有輕度耗損，但仍可使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 표시값은 %d%%입니다. 약간 저하되었지만 아직 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra %d%%. La batería tiene un leve desgaste, pero sigue siendo utilizable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages affichent %d%%. La batterie est légèrement usée mais reste utilisable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen %d%%. Die Batterie ist leicht verschlissen, aber weiterhin nutzbar."
          }
        }
      }
