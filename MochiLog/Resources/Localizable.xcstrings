    "%@ > %@" : {
      "comment" : "A header that shows the currently selected category and series in a hierarchical format.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ > %2$@"
          }
        }
      }
    },
    "%@: %lld%%" : {
      "comment" : "A footnote indicating that the health percentage is displayed by the operating system. The argument is the displayed percentage. The argument is the string “os_display”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld%%"
          }
        }
      }
    },
    "%@%%" : {
      "comment" : "A label displaying the health percentage of a device. The argument is a floating-point number representing the health percentage. The argument is the string “%.1f”.",
      "isCommentAutoGenerated" : true
    },
    "%lld%%" : {
      "comment" : "A text label displaying a percentage value. The argument is an integer representing the percentage.",
      "isCommentAutoGenerated" : true
    },
    "80%" : {
      "comment" : "A label indicating 80% on the health trend graph.",
      "isCommentAutoGenerated" : true
    },
