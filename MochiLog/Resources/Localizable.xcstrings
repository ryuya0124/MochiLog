    "tutorial_welcome": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "MochiLogへようこそ" } },
        "en": { "stringUnit": { "state": "translated", "value": "Welcome to MochiLog" } }
      }
    },
    "tutorial_step1_title": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "ログを取得する" } },
        "en": { "stringUnit": { "state": "translated", "value": "Get the Log" } }
      }
    },
    "tutorial_step1_description": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "設定アプリ > プライバシーとセキュリティ > 解析と改善 > 解析データから「Analytics」で始まるファイルを探してください。" } },
        "en": { "stringUnit": { "state": "translated", "value": "Go to Settings > Privacy & Security > Analytics & Improvements > Analytics Data and find files starting with 'Analytics'." } }
      }
    },
    "tutorial_step2_title": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "ログを共有する" } },
        "en": { "stringUnit": { "state": "translated", "value": "Share the Log" } }
      }
    },
    "tutorial_step2_description": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "ログファイルを開いて共有ボタンをタップし、MochiLogを選択するか、＋ボタンからファイルを直接選択してください。" } },
        "en": { "stringUnit": { "state": "translated", "value": "Open the log file, tap the share button and select MochiLog, or use the + button to select the file directly." } }
      }
    },
    "tutorial_step3_title": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "結果を確認する" } },
        "en": { "stringUnit": { "state": "translated", "value": "Check the Results" } }
      }
    },
    "tutorial_step3_description": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "解析が完了すると、バッテリーの詳細情報が表示されます。履歴を追跡して、バッテリーの状態を監視しましょう。" } },
        "en": { "stringUnit": { "state": "translated", "value": "Once parsing is complete, you'll see detailed battery information. Track history to monitor your battery health." } }
      }
    },
    "got_it": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "わかりました" } },
        "en": { "stringUnit": { "state": "translated", "value": "Got It" } }
